# Student-Agent 配置模板
# 复制此文件为 .env 并填写对应值

# ── 数据库 ──────────────────────────────────────────────
DATABASE_PATH=/data/chatbot.db

# ── Memory AI (学习通/钉钉消息 LLM 提取 + 日程 Agent) ──
# 支持任何 OpenAI 兼容接口
STANDBY_AGENT_PROVIDER=openai
STANDBY_AGENT_MODEL=gpt-4o-mini
# 如果是自定义 base_url，在 Settings → Provider 里配置，无需写这里

# ── Web Push 通知（可选） ────────────────────────────────
# 用 py-vapid 生成：python3 -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PRIVATE:', v.private_key()); print('PUBLIC:', v.public_key())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_MAILTO=mailto:admin@example.com

# ── 钉钉（可选，若不用钉钉可不填）─────────────────────
# 钉钉 SQLite DB 解密密钥（默认已内置，一般不需要改）
# DINGTALK_AES_KEY=9f6ac1b97a9021bd
# 你自己的钉钉 UID（区分自己发的消息，必填）
DINGTALK_SELF_UID=
# 钉钉 SQLite DB 路径（宿主机路径，挂载进容器）
# 默认已在 docker-compose.yml volumes 里配置，通常不需要改这里
# DINGTALK_DB_SOURCE=/dingtalk_db/dingtalk.db

# ── 调试 ────────────────────────────────────────────────
DEBUG=false
