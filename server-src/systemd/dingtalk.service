[Unit]
Description=DingTalk Linux Client (headless)
After=dingtalk-xvfb.service
Requires=dingtalk-xvfb.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 2
Environment=HOME=/root DISPLAY=:99
ExecStart=/opt/chatbot/server-src/start-dingtalk.sh
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
