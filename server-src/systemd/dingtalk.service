[Unit]
Description=DingTalk Linux Client (headless)
After=dingtalk-xvfb.service
Requires=dingtalk-xvfb.service

[Service]
Type=simple
Environment=DISPLAY=:99
ExecStartPre=/bin/sleep 2
ExecStart=/bin/bash -c 'DT_DIR="$(dirname "$(ls /opt/apps/com.alibabainc.dingtalk/files/*/com.alibabainc.dingtalk | sort -V | tail -1)")"; export LD_LIBRARY_PATH="$DT_DIR"; exec "$DT_DIR/com.alibabainc.dingtalk" --no-sandbox'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
