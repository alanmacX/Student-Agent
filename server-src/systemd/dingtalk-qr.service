[Unit]
Description=DingTalk QR Screenshot Helper
After=dingtalk.service
Requires=dingtalk-xvfb.service

[Service]
Type=simple
Environment=DISPLAY=:99
WorkingDirectory=/opt/chatbot/server-src
# Lock port 7777 to the Docker bridge + localhost before the helper comes up.
ExecStartPre=/bin/bash /opt/chatbot/server-src/scripts/qr-firewall.sh
ExecStart=/usr/bin/python3 /opt/chatbot/server-src/dingtalk_qr_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
